<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted ONLY for loopback: the Health extension
     polls opencode serve's health endpoint on this same device
     (http://127.0.0.1:4096/global/health), which is plain HTTP by
     design. Everything else stays HTTPS-only (the platform default
     for targetSdk 34). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
