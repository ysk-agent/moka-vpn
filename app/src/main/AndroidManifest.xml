<?xml version="1.0" encoding="utf-8"?>
<!-- The package attribute is for the manual (aapt2) build; Gradle
     builds take it from the namespace in app/build.gradle.kts and the
     two must stay identical. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.moriya.vpn">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ for a VpnService running as foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Declaration only, for the ADB keepalive extension (§9.7):
         it restores the wireless-debugging toggle (Settings.Global
         adb_wifi_enabled) when the toggle drops. The system never
         grants this permission automatically; it is granted once by
         hand over adb (`pm grant dev.moriya.vpn
         android.permission.WRITE_SECURE_SETTINGS`) after install.
         Without the declaration the grant cannot be given at all —
         measured against v1.1.0 on 2026-11-16, when the pm grant
         attempt failed for exactly this reason. Without the grant
         the extension only observes and reports. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Package visibility (Android 11+): the Startup management
         extension starts phone-node's NodeService with an explicit
         component intent. Without this declaration the resolution is
         silently filtered and startForegroundService returns null —
         the exact failure that made the phone-node helper's
         resurrection a silent no-op on the Libero (2026-11-14). -->
    <queries>
        <package android:name="dev.moriya.phonenode" />
    </queries>

    <application
        android:name=".MokaVpnApp"
        android:label="Moka VPN"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layer 1 VPN shell. It implements only our own TunHost
             interface; the libtailscale IPNService contract is bridged
             inside the Layer 3 adapter package (DESIGN.md §2/§3.3).
             BIND_VPN_SERVICE + the android.net.VpnService intent are
             what make the system treat this as the device VPN and what
             allow the user to designate it as the always-on VPN.
             SUPPORTS_ALWAYS_ON is declared so that designation is
             offered and the system may start the service with the
             "android.net.VpnService" action after boot/kill. -->
        <service
            android:name=".service.MokaVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>
</manifest>
