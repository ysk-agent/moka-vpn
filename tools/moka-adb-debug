#!/bin/bash
# moka-adb-debug — turn a node phone's USB debugging on/off from
# the VM, via the Moka VPN ADB keepalive extension's control
# endpoint (v1.3.0, DESIGN.md §9.7).
#
# Why: on mobile data, wireless debugging cannot keep adbd alive,
# so tailnet adb (port 5555) dies while the tunnel stays up. The
# endpoint lives on the tunnel: POST /adb-enabled/on writes
# Settings.Global adb_enabled=1 on the phone, adbd revives, and
# the persisted `adb tcpip 5555` listener comes back with it — no
# tcpip re-run, nobody touches the phone.
#
# Usage: moka-adb-debug on|off|status
#
# The endpoint requires the per-device token in an X-Moka-Token
# header. The token is generated by the app on the phone and shown
# in the ADB keepalive extension's status line; read it off the
# phone screen once and save it (mode 600) to:
#   ~/.config/moka-vpn/adb-debug-token
# This script never invents a token: without the file it explains
# and stops.
set -euo pipefail

TOKEN_FILE="$HOME/.config/moka-vpn/adb-debug-token"
NODE_HOST="***REMOVED***" # moto-g05, the current trial node
NODE_PORT="8091"

usage() {
    echo "usage: moka-adb-debug on|off|status" >&2
    exit 2
}

[ $# -eq 1 ] || usage
case "$1" in
    on|off|status) ;;
    *) usage ;;
esac

if [ ! -f "$TOKEN_FILE" ]; then
    cat >&2 <<EOF
moka-adb-debug: no token file at $TOKEN_FILE

The control endpoint needs the per-device token. On the phone,
open Moka VPN and read the token shown in the ADB keepalive
extension's status line, then save it here with mode 600:

  mkdir -p ~/.config/moka-vpn
  printf %s 'PASTE_TOKEN_HERE' > $TOKEN_FILE
  chmod 600 $TOKEN_FILE
EOF
    exit 1
fi

TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
if [ -z "$TOKEN" ]; then
    echo "moka-adb-debug: token file $TOKEN_FILE is empty" >&2
    exit 1
fi

if [ -z "${HTTPS_PROXY:-}" ]; then
    echo "moka-adb-debug: HTTPS_PROXY is not set (the tunnel proxy route is derived from it)" >&2
    exit 1
fi
# Same derivation the adb relay and the survival checks use: the
# runtime tunnel proxy lives on port 3130 of the egress proxy host.
TUNNEL_PROXY="${HTTPS_PROXY%:*}:3130"

case "$1" in
    on)
        curl -sS --max-time 15 --proxy "$TUNNEL_PROXY" \
            -X POST -H "X-Moka-Token: $TOKEN" \
            "http://$NODE_HOST:$NODE_PORT/adb-enabled/on"
        ;;
    off)
        curl -sS --max-time 15 --proxy "$TUNNEL_PROXY" \
            -X POST -H "X-Moka-Token: $TOKEN" \
            "http://$NODE_HOST:$NODE_PORT/adb-enabled/off"
        ;;
    status)
        curl -sS --max-time 15 --proxy "$TUNNEL_PROXY" \
            -H "X-Moka-Token: $TOKEN" \
            "http://$NODE_HOST:$NODE_PORT/status"
        ;;
esac
